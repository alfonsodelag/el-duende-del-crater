---
import { socialTiles } from "@/data/site";
import SectionHeading from "@components/ui/SectionHeading.astro";
---

<section class="section-shell community-section" aria-labelledby="community-title">
  <SectionHeading
    eyebrow="Comunidad"
    id="community-title"
    title="Ferias, proceso y pequeñas apariciones"
    text="Una mirada real al universo de El Duende del Cráter: el puesto, la cerveza servida y el emblema que acompaña cada lote."
  />
  <div class="social-grid">
    {
      socialTiles.map((tile) => (
        <article>
          <img src={tile.image} alt={tile.alt} width="720" height="720" loading="lazy" />
          <div>
            <span>{tile.label}</span>
            <p>{tile.title}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
